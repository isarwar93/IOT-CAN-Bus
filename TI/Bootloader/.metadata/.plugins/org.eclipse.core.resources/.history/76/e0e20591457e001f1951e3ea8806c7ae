uint32_t main(void)
{
    // SCIA Flush
    while(!ScibRegs.SCICTL2.bit.TXEMPTY)
    {
    }

    // Step 1. Initialize System Control:
    // Enable Peripheral Clocks
    // This example function is found in the F2837xD_SysCtrl.c file.
    InitSysCtrl(); //PLL activates


    // If the selection logic returns false, the code will trigger the flash bank 1 otherwise bank0
    if (bank_selection_logic() == 1)
    {
        return 0x082000;  // Bank 0 start entry point
    }
    else if (bank_selection_logic() == 0)
    {
        return 0x0A0000;  // Bank 1 start entry point
    }
    // Step 2. Initialize GPIO:
    // This example function is found in the F2837xD_Gpio.c file and
    // illustrates how to set the GPIO to it's default state.
    InitGpio();


//    GPIO_SetupPinMux(31, GPIO_MUX_CPU1, 0);
//    GPIO_SetupPinOptions(31, GPIO_OUTPUT, GPIO_PUSHPULL);
