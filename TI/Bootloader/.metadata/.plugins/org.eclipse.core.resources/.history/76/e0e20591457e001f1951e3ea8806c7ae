//Using #pragma to place this function in a custom memory section.
//#pragma CODE_SECTION(bank_selection_logic, "SELECTION_LOGIC")
bool bank_selection_logic(void)
{
    uint16_t* Magic_Number_Bank_0 = ((uint16_t *)0x080008);
    uint16_t* Rev_Bank_Address_0 = ((uint16_t *)0x080020);
    uint16_t* Magic_Number_Bank_1 = ((uint16_t *)0x0A0008);
    uint16_t* Rev_Bank_Address_1 = ((uint16_t *)0x080020);

    uint16_t Validity_Counter_Bank0 = 0;
    uint16_t Validity_Counter_Bank1 = 0;

    uint16_t Return_Status = 0;
    if (Magic_Number_Bank_0[0] == 0xCAAB)
    {
        Validity_Counter_Bank0++;
    }
    if (Magic_Number_Bank_0[1] == 0xCAAB)
    {
        Validity_Counter_Bank0++;
    }
    if (Magic_Number_Bank_0[2] == 0xBAAC)
    {
        Validity_Counter_Bank0++;
    }
    if (Magic_Number_Bank_0[3] == 0xCAA0)
    {
        Validity_Counter_Bank0++;
    }

    if (Validity_Counter_Bank0 != 4)
    {
        // The image looks not valid, we are left with Flash Bank1
        Return_Status = 2;
    }


    if (Magic_Number_Bank_1[0] == 0xCAAB)
    {
        Validity_Counter_Bank1++;
    }
    if (Magic_Number_Bank_1[1] == 0xCAAB)
    {
        Validity_Counter_Bank1++;
    }
    if (Magic_Number_Bank_1[2] == 0xBAAC)
    {
        Validity_Counter_Bank1++;
    }
    if (Magic_Number_Bank_1[3] == 0xCAA1)
    {
       Validity_Counter_Bank1++;
    }

    if (Validity_Counter_Bank1 != 4)
    {

        if (Return_Status == 0)// Previous image was fine, so, we left with only bank 0 image
        {
            Return_Status = 4;// code for no image valid
        }
        if (Return_Status == 2)// Previous image was also not fine, so, go to SCI-b wait for new flash
       {
           Return_Status = 6; // Code for only Bank 1 valid
       }
    }
    // Return_Status = 0; -> Both firwmares fine
    // Return_Status = 2; -> Bank 0 firmware not fine
    // Return_Status = 4; -> Bank 1 firmware not fine
    // Return_Status = 6; -> Both firmware not fine
    // This image looks not valid, we don't have any valid images,
     if (Return_Status == 2)// Previous image was also not fine, so, go to SCI-b wait for new flash
     {
         Return_Status = 4; // code for no image valid
         return Return_Status;
     }
     if (Return_Status == 0)// Previous image was fine, so, we left with only bank 0 image
     {
         Return_Status = 6; // Code for only Bank 1 valid
         return Return_Status;
     }

    // If the program reaches here, it means 'at least' one of the flash bank is valid
    if (return_status == 2)
    {
        // It means onl
    }
    else if (return_status == 0)
    {
        // Both banks are fine, now process with the revision check
    }


    // If both banks looks fine, then we can proceed with the latest revision check
    // First step -> check the major revision number
    if (Rev_Bank_Address_0[0] < Rev_Bank_Address_1[0])
    {
        return false;
    }
    else if (Rev_Bank_Address_0[0] > Rev_Bank_Address_1[0])
    {
        return true;
    }
    else if (Rev_Bank_Address_0[0] == Rev_Bank_Address_1[0])
    {
        // Second step -> check the minor revision number
        if (Rev_Bank_Address_0[2] < Rev_Bank_Address_1[2])
        {
            return false;
        }
        else if (Rev_Bank_Address_0[2] > Rev_Bank_Address_1[2])
        {
            return true;
        }
        // Third step -> check the sub minor revision number
        else if (Rev_Bank_Address_0[2] == Rev_Bank_Address_1[2])
        {
            if (Rev_Bank_Address_0[4] < Rev_Bank_Address_1[4])
            {
               return false;
            }
            else if (Rev_Bank_Address_0[4] > Rev_Bank_Address_1[4])
            {
               return true;
            }
            else if (Rev_Bank_Address_0[4] == Rev_Bank_Address_1[4])
            {
               // If everything is same and both are valid, bank0 will be having higher priority
               return true;
            }
        }
    }
    return true;
}

