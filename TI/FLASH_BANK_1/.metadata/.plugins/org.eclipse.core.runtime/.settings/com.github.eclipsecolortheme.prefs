eclipse.preferences.version=1
importedColorTheme1=<colorTheme author\="Ismail" id\="11" name\="Dark+ (VSCode)">\n     <foreground color\="\#569CD6"/> <\!-- General text color (light gray) -->\n     <background color\="\#1E1E1E"/> <\!-- Editor background (dark gray/black) -->\n     <selectionForeground color\="\#cfe8d5"/> <\!-- Selection text color (light mint) -->\n     <selectionBackground color\="\#686968"/> <\!-- Highlighted selection background (transparent light blue) -->\n     <currentLine color\="\#2A2A2A"/> <\!-- Current line background (dark gray) -->\n     <lineNumber color\="\#858585"/> <\!-- Line numbers color (medium gray) -->\n     <searchResultIndication color\="\#686968"/> <\!-- Search result highlight (dark gray) -->\n     <filteredSearchResultIndication color\="\#686968"/> <\!-- Filtered search highlight (dark gray) -->\n     <occurrenceIndication color\="\#686968"/> <\!-- Occurrence highlight (dark gray) -->\n     <writeOccurrenceIndication color\="\#686968"/> <\!-- Write occurrence highlight (dark gray) -->\n     <findScope color\="\#515C6A"/> <\!-- Find highlight (bluish gray) -->\n     <sourceHoverBackground color\="\#3E3E42"/> <\!-- Source hover background (dark bluish-gray) -->\n     \n     <\!-- Comments -->\n     <singleLineComment bold\="false" color\="\#6A9955" italic\="true"/> <\!-- Single-line comments (green, italic) -->\n     <multiLineComment bold\="false" color\="\#6A9955" italic\="true"/> <\!-- Multi-line comments (green, italic) -->\n \n     <\!-- C Language Specific -->\n     <preprocessor color\="\#c771c0"/> <\!-- Preprocessor commands (red) -->\n     <macro color\="\#569CD6"/> <\!-- Values of \#define macros (cyan) -->\n     <keyword color\="\#ba6ab4"/> <\!-- Keywords (e.g., return, if, else) (purple) -->\n     <typedef color\="\#569CD6"/> <\!-- Typedefs (blue) -->\n     <method color\="\#DCDCAA"/> <\!-- Functions (light yellow) -->\n     <inheritedMethod color\="\#DCDCAA"/> <\!-- Functions (light yellow) -->\n     <abstractMethod color\="\#DCDCAA"/> <\!-- Functions (light yellow) -->\n     <staticMethod color\="\#DCDCAA"/> <\!-- Functions (light yellow) -->\n     <methodDeclaration color\="\#DCDCAA"/> <\!-- Function declarations (blue) -->\n     <variable color\="\#9CDCFE"/> <\!-- Local variables (light blue) -->\n     <localVariable color\="\#D16969"/> <\!-- Local variables (red) -->\n     <field color\="\#9CDCFE"/> <\!-- Global variables (light blue) -->\n     <number color\="\#B5CEA8"/> <\!-- Numbers (light green) -->\n     <string color\="\#CE9178"/> <\!-- Strings (light brown) -->\n     <operator color\="\#D4D4D4"/> <\!-- Operators (e.g., +, -, *, /) (light gray) -->\n     <type color\="\#4EC9B0"/> <\!-- Types (e.g., int, float) (cyan) -->\n     \n     <\!-- Function Arguments -->\n     <parameterVariable color\="\#9CDCFE"/> <\!-- Function parameters (light blue) -->\n \n     <\!-- Classes, Structs, Enums -->\n     <class color\="\#4EC9B0"/> <\!-- Classes (cyan) -->\n     <struct color\="\#569CD6"/> <\!-- Structs (cyan) -->\n     <enum color\="\#569CD6"/> <\!-- Enums (light green) -->\n \n     <\!-- Punctuation and Symbols -->\n     <bracket color\="\#D4D4D4"/> <\!-- Brackets (light gray) -->\n     <delimiter color\="\#D4D4D4"/> <\!-- Commas, periods, etc. (light gray) -->\n \n     <\!-- Error/Warning Highlighting -->\n     <error color\="\#F44747"/> <\!-- Syntax errors (red) -->\n     <warning color\="\#FFCC00"/> <\!-- Warnings (yellow) -->\n     \n     <\!-- Other Configurations -->\n     <selectionBorder color\="\#515C6A"/> <\!-- Selection border (bluish gray) -->\n </colorTheme>
