#ifndef _CONFIG_H
#define _CONFIG_H

// Total 8 bytes are required to get information about the firmware
// 1. Flash bank number: 1 -> 1 byte
// 2. Starting fixed bytes: 0xBBCABBCABBCABB -> 7 bytes
#pragma DATA_SECTION(const_info, "CONST_INFO")
const uint64_t const_info = 0xBBCABBCABBCABB << 8 | 0x01;

// 3. Revision information: {2bytes:Major,0:(as comma),2Bytes:Minor,0:(as comma),2bytes:subminor} -> 8 bytes
#pragma DATA_SECTION(revision_number, "REV_INFO")
//                               Major     -   ,    -    Minor -   ,    Subminor
const uint32_t revision_number = 0x0001<<48|0x00<<40|0x0000<<24|0x00<<16|0x0001;
// Allocate a section for the revision number in flash memory
 CONST_INFO          : > 0x0A0008, PAGE = 0    , ALIGN(8)// Storing in Flash Bank 1 at address 0x0A0008
 REV_INFO            : > 0x0A0010, PAGE = 0    , ALIGN(8)// Storing in Flash Bank 1 at address 0x0A0010


#endif
